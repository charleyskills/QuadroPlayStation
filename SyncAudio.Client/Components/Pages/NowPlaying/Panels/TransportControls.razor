<div class="np-transport">
    <button class="np-transport-btn" type="button"
            disabled="@(!CanPrevious || !CanTransport)"
            @onclick="OnPrevious" title="Previous">
        <svg width="28" height="22" viewBox="0 0 32 25" fill="#fff">
            <rect x="0" y="2" width="3.2" height="21" rx="1.2"/>
            <path d="M30.4 1.4c1 -.6 2.3 .1 2.3 1.3v19.6c0 1.2 -1.3 1.9 -2.3 1.3L7.5 13.4a1.5 1.5 0 010 -2.6L30.4 1.4z" transform="translate(-2 0)"/>
        </svg>
    </button>

    <button class="np-play-btn @(IsBuffering ? "is-buffering" : "")" type="button"
            disabled="@(!CanTransport)"
            @onclick="OnTogglePlay"
            title="@(IsPlaying ? "Stop" : "Play")">
        @if (IsBuffering)
        {
            <span class="np-play-spinner"></span>
        }
        else if (IsPlaying)
        {
            <svg width="28" height="28" viewBox="0 0 36 36" fill="#000">
                <rect x="8" y="8" width="20" height="20" rx="2"/>
            </svg>
        }
        else
        {
            <svg width="28" height="28" viewBox="0 0 36 36" fill="#000">
                <path d="M9 4.5c0-1.5 1.6-2.4 2.9-1.7l21 13.5a2 2 0 010 3.4L11.9 33.2c-1.3.8-2.9-.2-2.9-1.7V4.5z"/>
            </svg>
        }
    </button>

    <button class="np-transport-btn" type="button"
            disabled="@(!CanNext || !CanTransport)"
            @onclick="OnNext" title="Next">
        <svg width="28" height="22" viewBox="0 0 32 25" fill="#fff">
            <path d="M2.6 1.4c-1 -.6 -2.3 .1 -2.3 1.3v19.6c0 1.2 1.3 1.9 2.3 1.3L25.5 13.4a1.5 1.5 0 000 -2.6L2.6 1.4z" transform="translate(2 0)"/>
            <rect x="28.8" y="2" width="3.2" height="21" rx="1.2"/>
        </svg>
    </button>
</div>

@code {
    [Parameter] public bool CanPrevious { get; set; }
    [Parameter] public bool CanNext { get; set; }
    [Parameter] public bool CanTransport { get; set; }
    [Parameter] public bool IsPlaying { get; set; }
    [Parameter] public bool IsBuffering { get; set; }

    [Parameter] public EventCallback OnPrevious { get; set; }
    [Parameter] public EventCallback OnTogglePlay { get; set; }
    [Parameter] public EventCallback OnNext { get; set; }
}
