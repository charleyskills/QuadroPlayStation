<div class="np-volume">
    <svg class="np-vol-icon" width="14" height="14" viewBox="0 0 14 14" fill="currentColor">
        <path d="M2 5h2.5L8 2v10L4.5 9H2V5z"/>
    </svg>
    <input class="np-vol-slider" type="range" min="0" max="100" step="1"
           value="@((int)Math.Round(Volume * 100))"
           @oninput="HandleInput" />
    <svg class="np-vol-icon" width="16" height="16" viewBox="0 0 18 18" fill="none">
        <path d="M2 6.5h2.5L8 3.5v11L4.5 11.5H2v-5z" fill="currentColor"/>
        <path d="M11 5c1.4 1 2.2 2.4 2.2 4s-.8 3-2.2 4M14 2.5c2.4 1.5 3.7 4 3.7 6.5s-1.3 5-3.7 6.5"
              stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none"/>
    </svg>
</div>

@code {
    [Parameter] public double Volume { get; set; }
    [Parameter] public EventCallback<double> OnVolumeChanged { get; set; }

    private Task HandleInput(ChangeEventArgs e)
    {
        if (e.Value is null) return Task.CompletedTask;
        if (!int.TryParse(e.Value.ToString(), out var pct)) return Task.CompletedTask;
        return OnVolumeChanged.InvokeAsync(pct / 100.0);
    }
}
