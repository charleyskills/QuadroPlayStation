<div class="@ScrimClass" @onclick="OnTogglePanel"></div>
<div class="@SheetClass">
    <div class="grabber"><span></span></div>
    <div class="sheet-header">
        <button class="sheet-close" type="button" @onclick="OnTogglePanel" title="Close">
            <svg width="18" height="11" viewBox="0 0 22 13" fill="none">
                <path d="M2 2l9 9 9-9" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </button>
        <div class="sheet-title">Plex</div>
        @if (IsPlexConnected)
        {
            <div style="display:flex;align-items:center;gap:4px;">
                @if (Albums.Count > 0)
                {
                    <button class="sheet-discover-btn @(DiscoverViewOpen ? "sheet-discover-btn--active" : "")"
                            type="button"
                            title="Discover view"
                            @onclick="OnToggleDiscoverView">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                            <rect x="1" y="1" width="6" height="6" rx="1.5" fill="currentColor"/>
                            <rect x="9" y="1" width="6" height="6" rx="1.5" fill="currentColor"/>
                            <rect x="1" y="9" width="6" height="6" rx="1.5" fill="currentColor"/>
                            <rect x="9" y="9" width="6" height="6" rx="1.5" fill="currentColor"/>
                        </svg>
                    </button>
                }
                <button class="sheet-discover-btn @(_searchOpen ? "sheet-discover-btn--active" : "")"
                        type="button" title="Search"
                        @onclick="OpenSearch">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                </button>
                <button class="sheet-discover-btn" type="button"
                        title="Reload DTS albums from Plex"
                        disabled="@(IsPlexSearching || IsPlexLoadingMore)"
                        @onclick="OnRefreshAlbums">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M23 4v6h-6"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>
                    </svg>
                </button>
            </div>
        }
        else
        {
            <div class="sheet-spacer"></div>
        }
    </div>
    @if (_searchOpen)
    {
        <div class="plex-search-bar">
            <input class="plex-search-input" type="text" @bind="_searchDraft"
                   @bind:event="oninput"
                   @onkeydown="HandleSearchKeyDown"
                   placeholder="Search Plex…" />
            <button class="sheet-discover-btn" type="button" @onclick="SubmitSearch" title="Go">Go</button>
            <button class="sheet-discover-btn" type="button" @onclick="CloseSearch" title="Cancel">✕</button>
        </div>
    }
    <div class="sheet-scroll">
        <div class="sheet-section plex-section-body">
            <PlexConnectPanel IsConnected="IsPlexConnected"
                              Username="@PlexUsername"
                              OnConnected="OnPlexConnected"
                              OnDisconnected="OnPlexDisconnected" />
            @if (IsPlexConnected)
            {
                @if (IsPlexSearching)
                {
                    <div class="empty-row">Searching for "@PlexSearchQuery"…</div>
                }
                else if (Albums.Count > 0)
                {
                    <div class="sheet-list">
                        @foreach (var album in Albums)
                        {
                            var isExpanded = album.RatingKey == expandedKey;
                            var isCollapsing = !isExpanded && album.RatingKey == _collapsedFromKey;
                            <button class="queue-row" type="button"
                                    @onclick="@(() => HandleAlbumClick(album.RatingKey))">
                                @if (album.CoverUrl is { } u)
                                {
                                    <img class="mini-cover" src="@u" alt="" draggable="false" />
                                }
                                else
                                {
                                    <div class="mini-cover" style="--c0:#5EC8FF;--c1:#7A3CFF;--c2:#FF8FB1;"></div>
                                }
                                <div class="row-text">
                                    <div class="row-title">@album.Title</div>
                                    <div class="row-artist">@album.Artist@(album.Year is { } y ? $" · {y}" : "")</div>
                                </div>
                                <span class="plex-badge">DTS</span>
                                <span class="row-dur">@(album.TrackCount > 0 ? $"{album.TrackCount} tr" : "")</span>
                            </button>
                            <div class="plex-inline-wrap @(isExpanded ? "plex-inline-wrap--open" : "")">
                                <div class="plex-inline-inner">
                                    @if (isExpanded)
                                    {
                                        @if (IsPlexLoadingAlbum)
                                        {
                                            <div class="plex-inline-loading">Loading tracks…</div>
                                        }
                                        else
                                        {
                                            <div class="plex-inline-tracks">
                                                @for (var i = 0; i < AlbumTracks.Count; i++)
                                                {
                                                    var t = AlbumTracks[i];
                                                    var num = i + 1;
                                                    var isCurrent = t.Id == CurrentTrackId;
                                                    <button class="plex-track-row @(isCurrent ? "plex-track-row--current" : "")"
                                                            type="button"
                                                            @onclick="@(() => OnTrackSelect.InvokeAsync(t))">
                                                        <span class="plex-track-row__num">@num</span>
                                                        <span class="plex-track-row__text">
                                                            <span class="plex-track-row__title">@t.Title</span>
                                                            <span class="plex-track-row__dur">@t.DurationDisplay</span>
                                                        </span>
                                                    </button>
                                                }
                                            </div>
                                        }
                                    }
                                    else if (isCollapsing && _collapsedFromTracks.Count > 0)
                                    {
                                        <div class="plex-inline-tracks">
                                            @for (var i = 0; i < _collapsedFromTracks.Count; i++)
                                            {
                                                var t = _collapsedFromTracks[i];
                                                var num = i + 1;
                                                <button class="plex-track-row" type="button" disabled>
                                                    <span class="plex-track-row__num">@num</span>
                                                    <span class="plex-track-row__text">
                                                        <span class="plex-track-row__title">@t.Title</span>
                                                        <span class="plex-track-row__dur">@t.DurationDisplay</span>
                                                    </span>
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    <div class="plex-page-status">
                        @if (IsPlexLoadingMore)
                        {
                            <span>Loading more…</span>
                        }
                        else if (HasMore)
                        {
                            <span>@Albums.Count of @AlbumTotal · scroll for more</span>
                        }
                        else
                        {
                            <span>@Albums.Count album@(Albums.Count == 1 ? "" : "s")</span>
                        }
                    </div>
                    @if (HasMore)
                    {
                        <div id="@LoadMoreSentinelId" class="plex-load-more-sentinel"></div>
                    }
                }
                else
                {
                    <div class="empty-row">No results for "@PlexSearchQuery".</div>
                }
            }
        </div>
    </div>
</div>

@code {
    /// <summary>DOM id for the load-more sentinel; the parent installs the IntersectionObserver against this element.</summary>
    public const string LoadMoreSentinelId = "plex-load-more-sentinel";

    [Parameter] public string ScrimClass { get; set; } = "";
    [Parameter] public string SheetClass { get; set; } = "";
    [Parameter] public bool IsPlexConnected { get; set; }
    [Parameter] public string? PlexUsername { get; set; }
    [Parameter] public bool IsPlexSearching { get; set; }
    [Parameter] public bool IsPlexLoadingMore { get; set; }
    [Parameter] public bool IsPlexLoadingAlbum { get; set; }
    [Parameter] public bool DiscoverViewOpen { get; set; }
    [Parameter] public IReadOnlyList<PlexAlbumSummary> Albums { get; set; } = [];
    [Parameter] public int AlbumTotal { get; set; }
    [Parameter] public bool HasMore { get; set; }

    [Parameter] public string PlexSearchQuery { get; set; } = "";
    [Parameter] public EventCallback<string> OnSearch { get; set; }

    [Parameter] public IReadOnlyList<Track> AlbumTracks { get; set; } = [];
    [Parameter] public string? CurrentTrackId { get; set; }
    [Parameter] public string? SelectedAlbumRatingKey { get; set; }

    [Parameter] public EventCallback OnTogglePanel { get; set; }
    [Parameter] public EventCallback OnToggleDiscoverView { get; set; }
    [Parameter] public EventCallback OnRefreshAlbums { get; set; }
    [Parameter] public EventCallback OnPlexConnected { get; set; }
    [Parameter] public EventCallback OnPlexDisconnected { get; set; }
    [Parameter] public EventCallback<string> OnAlbumPlay { get; set; }
    [Parameter] public EventCallback<Track> OnTrackSelect { get; set; }

    private bool _searchOpen;
    private string _searchDraft = "";
    private string? _pendingRatingKey;
    private string? _collapsedFromKey;
    private IReadOnlyList<Track> _collapsedFromTracks = [];

    private string? expandedKey => IsPlexLoadingAlbum ? _pendingRatingKey : SelectedAlbumRatingKey;

    private async Task HandleAlbumClick(string ratingKey)
    {
        var current = expandedKey;
        if (current != null && current != ratingKey
            && current == SelectedAlbumRatingKey && AlbumTracks.Count > 0)
        {
            _collapsedFromKey = current;
            _collapsedFromTracks = AlbumTracks;
        }
        else
        {
            _collapsedFromKey = null;
            _collapsedFromTracks = [];
        }
        _pendingRatingKey = ratingKey;
        await OnAlbumPlay.InvokeAsync(ratingKey);
        await Task.Delay(300);
        await InvokeAsync(() => { _collapsedFromKey = null; _collapsedFromTracks = []; StateHasChanged(); });
    }

    private void OpenSearch() { _searchDraft = PlexSearchQuery; _searchOpen = true; }
    private void CloseSearch() => _searchOpen = false;

    private async Task SubmitSearch()
    {
        var q = _searchDraft.Trim();
        if (string.IsNullOrEmpty(q)) return;
        _searchOpen = false;
        await OnSearch.InvokeAsync(q);
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SubmitSearch();
        else if (e.Key == "Escape") CloseSearch();
    }
}
