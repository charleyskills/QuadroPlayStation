@implements IDisposable

<div class="np-sync-body">
        @* — Sync group section — *@
        <div class="np-sync-section">
            <div class="np-section-label">Sync group</div>
            @if (!IsJoined)
            {
                <div class="np-sync-group">
                    <input class="np-sync-input" @bind="@_groupNameDraft" placeholder="group name" />
                    <button class="np-sync-join-btn" type="button" @onclick="HandleJoinClick">Join</button>
                </div>
            }
            else
            {
                <div class="np-sync-group">
                    <div class="np-sync-status">
                        <div class="np-sync-status-main">
                            Listening with @MemberCount · @GroupName
                        </div>
                        <div class="np-sync-status-sub">
                            @(IsSplitting ? "Splitting…" : IsBuffering ? "Buffering…" : "Ready")
                        </div>
                    </div>
                </div>
            }
            <div class="np-sync-readout">
                offset @(OffsetMs >= 0 ? "+" : "")@OffsetMs ms · sync @(LatencyOffsetMs >= 0 ? "+" : "")@LatencyOffsetMs ms
            </div>
            <div class="np-latency-row">
                <button class="np-latency-btn" type="button"
                        @onclick="@(() => OnAdjustLatency.InvokeAsync(-3))"
                        title="Play 50 ms later">−3</button>
                <button class="np-latency-btn" type="button"
                        @onclick="@(() => OnAdjustLatency.InvokeAsync(-1))"
                        title="Play 10 ms later">−1</button>
                <button class="np-latency-btn" type="button"
                        @onclick="@(() => OnAdjustLatency.InvokeAsync(-LatencyOffsetMs))"
                        title="Reset sync to 0 ms">0</button>
                <button class="np-latency-btn" type="button"
                        @onclick="@(() => OnAdjustLatency.InvokeAsync(1))"
                        title="Play 10 ms earlier">+1</button>
                <button class="np-latency-btn" type="button"
                        @onclick="@(() => OnAdjustLatency.InvokeAsync(3))"
                        title="Play 50 ms earlier">+3</button>
            </div>
            <div class="np-latency-slider-row">
                <span class="np-latency-slider-label">@(_sliderDisplayMs >= 0 ? "+" : "")@_sliderDisplayMs ms</span>
                <input type="range" min="-10" max="10" step="1"
                       value="@_sliderDisplayMs"
                       @oninput="HandleOffsetSlider" />
            </div>
        </div>

        @* — Channel routing section (only when channels reported) — *@
        @if (Channels > 0)
        {
            <div class="np-sync-section">
                <div class="np-section-label">Channel routing</div>
                <div class="np-channel-row">
                    <div class="np-channel-cell">
                        <label for="np-ch-left">Left</label>
                        <select id="np-ch-left" class="np-channel-select"
                                value="@LeftChannel" @onchange="HandleLeftChange">
                            @for (var i = 0; i < Channels; i++)
                            {
                                <option value="@i">@ChannelLabel(i, Channels)</option>
                            }
                        </select>
                    </div>
                    <div class="np-channel-cell">
                        <label for="np-ch-right">Right</label>
                        <select id="np-ch-right" class="np-channel-select"
                                value="@RightChannel" @onchange="HandleRightChange">
                            @for (var i = 0; i < Channels; i++)
                            {
                                <option value="@i">@ChannelLabel(i, Channels)</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="np-channel-presets">
                    @if (Channels >= 2)
                    {
                        <button class="np-preset-btn" type="button" @onclick="@(() => OnChannelMap.InvokeAsync((0, 1)))">FL · FR</button>
                    }
                    @if (Channels >= 4)
                    {
                        var slIdx = Channels >= 6 ? 4 : 2;
                        var srIdx = Channels >= 6 ? 5 : 3;
                        <button class="np-preset-btn" type="button" @onclick="@(() => OnChannelMap.InvokeAsync((slIdx, srIdx)))">SL · SR</button>
                    }
                    @if (Channels >= 6)
                    {
                        <button class="np-preset-btn" type="button" @onclick="@(() => OnChannelMap.InvokeAsync((2, 3)))">FC · LFE</button>
                    }
                </div>
            </div>
        }

    </div>

@code {
    [Parameter] public bool IsJoined { get; set; }
    [Parameter] public int MemberCount { get; set; }
    [Parameter] public string GroupName { get; set; } = "";
    [Parameter] public bool IsSplitting { get; set; }
    [Parameter] public bool IsBuffering { get; set; }
    [Parameter] public long OffsetMs { get; set; }
    [Parameter] public int LatencyOffsetMs { get; set; }
    [Parameter] public int Channels { get; set; }
    [Parameter] public int LeftChannel { get; set; }
    [Parameter] public int RightChannel { get; set; }

    [Parameter] public EventCallback<string> OnJoin { get; set; }
    [Parameter] public EventCallback<int> OnAdjustLatency { get; set; }
    [Parameter] public EventCallback<(int Left, int Right)> OnChannelMap { get; set; }

    private string _groupNameDraft = "demo";
    private bool _groupNameDraftSeeded;
    private int _sliderDisplayMs;
    private int _lastSyncedLatencyOffsetMs;
    private CancellationTokenSource? _sliderDebounceCts;

    protected override void OnParametersSet()
    {
        // Seed the input from the parent's group name on first parameter set.
        if (!_groupNameDraftSeeded && !string.IsNullOrWhiteSpace(GroupName))
        {
            _groupNameDraft = GroupName;
            _groupNameDraftSeeded = true;
        }

        // Sync the slider display when the parent's latency offset changes externally
        // (e.g. JS pushed a new value via UpdateLatencyOffset). Don't clobber the user's
        // mid-drag value if the parameter hasn't changed since the last sync.
        if (_lastSyncedLatencyOffsetMs != LatencyOffsetMs)
        {
            _sliderDisplayMs = LatencyOffsetMs;
            _lastSyncedLatencyOffsetMs = LatencyOffsetMs;
        }
    }

    private async Task HandleJoinClick()
    {
        if (string.IsNullOrWhiteSpace(_groupNameDraft)) return;
        await OnJoin.InvokeAsync(_groupNameDraft.Trim());
    }

    private void HandleOffsetSlider(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var newVal)) return;
        _sliderDisplayMs = newVal;

        _sliderDebounceCts?.Cancel();
        _sliderDebounceCts = new CancellationTokenSource();
        var token = _sliderDebounceCts.Token;
        var currentOffset = LatencyOffsetMs;

        _ = Task.Delay(80, token).ContinueWith(async t =>
        {
            if (t.IsCanceled) return;
            var delta = newVal - currentOffset;
            if (delta == 0) return;
            await InvokeAsync(() => OnAdjustLatency.InvokeAsync(delta));
        }, TaskScheduler.Default);
    }

    private Task HandleLeftChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var l))
        {
            return OnChannelMap.InvokeAsync((l, RightChannel));
        }
        return Task.CompletedTask;
    }

    private Task HandleRightChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var r))
        {
            return OnChannelMap.InvokeAsync((LeftChannel, r));
        }
        return Task.CompletedTask;
    }

    private static string ChannelLabel(int i, int channels) => channels switch
    {
        6 => i switch { 0 => "0 · FL", 1 => "1 · FR", 2 => "2 · FC", 3 => "3 · LFE", 4 => "4 · SL", 5 => "5 · SR", _ => $"ch {i}" },
        4 => i switch { 0 => "0 · FL", 1 => "1 · FR", 2 => "2 · SL", 3 => "3 · SR", _ => $"ch {i}" },
        2 => i switch { 0 => "0 · L", 1 => "1 · R", _ => $"ch {i}" },
        _ => $"ch {i}"
    };

    public void Dispose()
    {
        _sliderDebounceCts?.Cancel();
        _sliderDebounceCts?.Dispose();
    }
}
