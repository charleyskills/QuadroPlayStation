@using SyncAudio.Core.Models
@inject IJSRuntime JS
@implements IAsyncDisposable

@*
    Vertical 3D Coverflow discover panel. Ported from the Album Coverflow
    handoff design (`api.anthropic.com/v1/design/h/z4YY1CRgpHT0VtTlMISC9g`)
    with Blur Mode = Shadow Overlay.

    Physics + per-frame styling live entirely in coverflowInterop.js — Blazor
    only renders the static skeleton and reissues `refresh` when the album list
    changes (e.g. load-more appended new cards).
*@

<div class="cf-overlay" id="plex-coverflow">

    <div class="cf-bg" data-cf-bg></div>
    <div class="cf-bg-vignette"></div>

    <div class="cf-topbar">
        <div class="cf-topbar__plex" title="Plex">
            <svg width="31" height="14" viewBox="0 0 105 48" fill="none" aria-hidden="true">
                <path d="M17.113 8.58569C12.9921 8.58569 10.3029 9.78804 8.01351 12.5924V9.50146H0V47.619C0 47.619 0.162684 47.6955 0.545152 47.7773C1.13879 47.9045 4.06709 48.58 6.25631 46.7086C8.15034 45.0882 8.5856 43.2125 8.5856 41.0534V35.5438C10.875 38.0045 13.5081 39.0355 17.1712 39.0355C25.0694 39.0355 31.1361 32.6251 31.1361 24.0967C31.1361 14.9971 25.2978 8.58677 17.113 8.58677V8.58569ZM15.5519 31.8613C11.1454 31.8613 7.62135 28.2111 7.62135 23.7422C7.62135 19.2732 11.7466 15.8741 15.5519 15.8741C20.0209 15.8741 23.4825 19.3368 23.4825 23.8047C23.4825 28.2726 20.0209 31.8613 15.5519 31.8613Z" fill="#fff"/>
                <path d="M42.5294 23.2691C42.5294 26.5691 42.8946 30.5737 46.1483 34.9533C46.2118 35.0384 46.3896 35.2528 46.3896 35.2528C45.0741 37.5109 43.4171 39.03 41.2462 39.03C39.5332 39.03 37.8611 38.124 36.4681 36.5445C34.9791 34.8563 34.2681 32.652 34.2681 30.3572V0H42.5315L42.5283 23.2691H42.5294Z" fill="#fff"/>
                <path d="M83.2283 38.1208H73.2884L82.9363 23.8186L73.2884 9.50464H83.2283L92.8751 23.8186L83.2283 38.1208Z" fill="#EBAF00"/>
                <path d="M95.5265 22.1972L104.15 9.50464H94.1712L90.5361 14.7935L95.5265 22.1972Z" fill="#fff"/>
                <path d="M90.5361 32.8965C90.5383 32.903 92.2276 35.2527 92.2276 35.2527C93.8587 37.8104 95.951 39.0257 98.4451 39.0354C101.032 38.9891 102.874 36.6964 103.55 35.8927C103.55 35.8916 102.273 34.7679 100.691 32.89C98.5378 30.3324 95.6364 25.6856 95.5265 25.4863L90.5372 32.8976L90.5361 32.8965Z" fill="#fff"/>
                <path d="M65.8599 29.8906C64.1975 31.4237 63.0641 32.3115 60.7014 32.3115C56.5148 32.3115 54.1682 29.3897 53.8246 26.1274H75.8687C76.0077 25.6813 76.0982 25.1265 76.0982 24.2096C76.0982 15.2814 69.5726 8.58447 60.988 8.58447C52.4035 8.58447 46.1073 15.3956 46.1073 23.9231C46.1073 32.4505 52.8032 39.0332 61.1604 39.0332C66.9955 39.0332 72.0333 35.6945 74.8032 29.8896H65.861L65.8599 29.8906ZM61.0419 15.345C64.692 15.345 67.4232 17.7529 68.0524 20.8999H54.095C54.8502 17.5644 57.3918 15.345 61.043 15.345H61.0419Z" fill="#fff"/>
            </svg>
        </div>

        <div class="cf-topbar__title">
            <div class="cf-eyebrow">Browse Albums</div>
            <div class="cf-count" data-cf-count>@(Albums.Count > 0 ? $"1 of {Albums.Count}" : "")</div>
        </div>

        <button class="cf-close" type="button" title="Back" @onclick="OnClose">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M12 4L4 12M4 4l8 8" stroke="rgba(255,255,255,0.85)" stroke-width="2" stroke-linecap="round"/>
            </svg>
        </button>
    </div>

    <div class="cf-stage">
        <div class="cf-card-container">
            @foreach (var album in Albums.Skip(_windowStart).Take(Math.Min(Albums.Count - _windowStart, WindowHalf * 2 + 1)))
            {
                var coverUrl = album.CoverUrl is { } u ? NowPlayingHelpers.AsLargeCover(u) : null;
                var artistLine = album.Artist + (album.Year is { } y ? $" · {y}" : "");

                <button class="cf-card"
                        type="button"
                        data-cf-card
                        data-rating-key="@album.RatingKey"
                        data-title="@album.Title"
                        data-artist="@artistLine"
                        data-cover-url="@(coverUrl ?? "")"
                        disabled="@IsLoadingAlbum"
                        @key="album.RatingKey">
                    @if (coverUrl is not null)
                    {
                        <img class="cf-card__img"
                             src="@coverUrl"
                             alt="@album.Title"
                             draggable="false"
                             crossorigin="anonymous" />
                    }
                    else
                    {
                        <div class="cf-card__img cf-card__img--placeholder"></div>
                    }
                    <div class="cf-card__overlay" data-cf-overlay></div>
                </button>
            }
        </div>
    </div>

    <div class="cf-info" data-cf-info>
        <div class="cf-info__title" data-cf-info-title>@(Albums.FirstOrDefault()?.Title ?? "")</div>
        <div class="cf-info__artist" data-cf-info-artist>@(Albums.FirstOrDefault() is { } first ? first.Artist + (first.Year is { } fy ? $" · {fy}" : "") : "")</div>
    </div>

    <div class="cf-position-bar">
        @for (var i = 0; i < Albums.Count; i++)
        {
            <div class="cf-position-dot" data-cf-dot></div>
        }
    </div>

    @if (IsLoadingMore)
    {
        <div class="cf-loading-more">Loading more…</div>
    }

    @if (HasMore)
    {
        <div id="@NowPlayingBase.DiscoverLoadMoreSentinelId" class="cf-load-sentinel"></div>
    }

</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<PlexAlbumSummary> Albums { get; set; } = [];
    [Parameter] public bool IsLoadingAlbum { get; set; }
    [Parameter] public bool HasMore { get; set; }
    [Parameter] public bool IsLoadingMore { get; set; }
    [Parameter] public EventCallback<string> OnAlbumSelect { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private const int WindowHalf = 30;  // render nearest ± 30 = at most 61 cards
    private int _windowStart = 0;
    private int _lastWindowStart = -1;  // –1 so first render always syncs the offset
    private DotNetObjectReference<PlexAlbumDiscoverPanel>? _selfRef;
    private int _lastAlbumCount;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("coverflowInterop.install", "plex-coverflow", _selfRef, Albums.Count, _windowStart);
                _lastAlbumCount  = Albums.Count;
                _lastWindowStart = _windowStart;
            }
            catch { /* circuit may be gone */ }
            return;
        }

        if (Albums.Count != _lastAlbumCount || _windowStart != _lastWindowStart)
        {
            _lastAlbumCount  = Albums.Count;
            _lastWindowStart = _windowStart;
            try { await JS.InvokeVoidAsync("coverflowInterop.refresh", "plex-coverflow", _windowStart, Albums.Count); }
            catch { }
        }
    }

    [JSInvokable]
    public Task OnCoverflowSelect(string ratingKey)
        => OnAlbumSelect.InvokeAsync(ratingKey);

    [JSInvokable]
    public async Task UpdateWindowCenter(int nearest)
    {
        var windowSize = Math.Min(Albums.Count, WindowHalf * 2 + 1);
        var newStart   = Math.Max(0, Math.Min(nearest - WindowHalf, Albums.Count - windowSize));
        if (newStart == _windowStart)
        {
            // No actual window shift needed (clamped at start/end of list), but JS set
            // s.windowUpdatePending = true before invoking us — clear it via a no-op refresh
            // so future shift triggers can fire. Without this the trigger guard stays armed
            // forever and virtualization silently dies after either list boundary is touched.
            try { await JS.InvokeVoidAsync("coverflowInterop.refresh", "plex-coverflow", _windowStart, Albums.Count); }
            catch { }
            return;
        }
        _windowStart = newStart;
        await InvokeAsync(StateHasChanged);
        // OnAfterRenderAsync fires next and calls coverflowInterop.refresh with the new offset.
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("coverflowInterop.uninstall", "plex-coverflow"); }
        catch { }
        _selfRef?.Dispose();
    }
}
