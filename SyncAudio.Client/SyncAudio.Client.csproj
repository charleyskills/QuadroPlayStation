<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SyncAudio.Client</RootNamespace>
    <LangVersion>default</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Content Update="wwwroot\audio\track.flac">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Aspire.Minio.Client" Version="13.2.1-beta.532" />
    <PackageReference Include="Stateless" Version="5.16.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SyncAudio.Core\SyncAudio.Core.csproj" />
    <ProjectReference Include="..\SyncAudio.ServiceDefaults\SyncAudio.ServiceDefaults.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SyncAudio.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="wwwroot\audio\" />
  </ItemGroup>
</Project>
