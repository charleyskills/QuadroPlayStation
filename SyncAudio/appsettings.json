{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Ffmpeg": {
    "FfmpegPath": "ffmpeg",
    "FfprobePath": "ffprobe",
    "TimeoutSeconds": 600
  },
  "Plex": {
    "Product": "SyncAudio",
    "DeviceName": "SyncAudio Server",
    "Platform": "Web",
    "Version": "1.0",
    "ClientIdentifierFile": "App_Data/plex-client-id",
    "DataProtectionKeysDirectory": "App_Data/keys"
  }
}
